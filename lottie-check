def badge(state, label=None):
    text = label or {"ok": "plays", "fail": "fails", "warn": "warnings", "skip": "skipped"}[state]
    return f'<span class="b {state}">{text}</span>'


def check_state(r):
    if r is None:
        return "skip"
    return "ok" if r["ok"] else "fail"


def write_report(result, out: Path):
    lint_res, ios, android, frames = result["lint"], result["ios"], result["android"], result["frames"]
    lint_state = "fail" if lint_res["errors"] else "warn" if lint_res["warnings"] else "ok"

    def section(title, state, detail, notes, label=None):
        items = "".join(f"<li>{html.escape(n)}</li>" for n in notes)
        return (f"<div class='card'><h2>{title} {badge(state, label)}</h2><p class='mono'>{html.escape(detail or '')}</p>"
                f"{'<ul>' + items + '</ul>' if items else ''}</div>")

    rows = ""
    for f in frames:
        cells = ""
        for prefix, res in (("ios", ios), ("android", android)):
            img = out / f"{prefix}-f{f}.png"
            # embedded so the report survives being moved or shared
            src = f"data:image/png;base64,{base64.b64encode(img.read_bytes()).decode()}" if res and res["ok"] and img.exists() else None
            cells += f"<td>{f'<img src={src}>' if src else '<div class=empty>—</div>'}</td>"
        rows += f"<tr><th>frame {f}</th>{cells}</tr>"
    lint_items = [f"error: {e}" for e in lint_res["errors"]] + [f"warning: {w}" for w in lint_res["warnings"]]
    page = f"""<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">
<title>{html.escape(result['name'])}</title><style>{CSS}</style>
<h1>{html.escape(result['name'])}</h1>
<p class=mono>{html.escape(' · '.join(f'{k} {v}' for k, v in lint_res['info'].items()))}</p>
<div class=cards>
{section('Lint', lint_state, '', lint_items, {'ok': 'clean', 'warn': 'warnings', 'fail': 'issues'}[lint_state])}
{section('iOS · lottie-ios 4.5.0', check_state(ios), ios and ios['detail'], ios['notes'] if ios else [])}
{section(f"Android · lottie-android 6.5.2 · {result['android_via']}", check_state(android), android and android['detail'], android['notes'] if android else [])}
</div>
<table class=frames><tr><th></th><th>iOS</th><th>Android</th></tr>{rows}</table>"""
    (out / "report.html").write_text(page)


def write_index(results, out_root: Path):
    rows = ""
    for r in results:
        cost = next((n.split(": ", 1)[1] for n in (r["android"] or {}).get("notes", []) if n.startswith("draw cost")), "")
        p50 = re.search(r"p50=([\d.]+ms)", cost)
        worst = re.search(r"max=([\d.]+ms)", cost)
        status_label = {"pass": "passes", "warn": "warnings", "fail": "fails"}[r["status"]]
        issues = r["lint"]["errors"] + r["lint"]["warnings"]
        note = issues[0] + (f" (+{len(issues) - 1} more)" if len(issues) > 1 else "") if issues else ""
        rows += (f"<tr><td><a href='{html.escape(r['report_rel'])}'>{html.escape(r['name'])}</a></td>"
                 f"<td>{badge({'pass': 'ok', 'warn': 'warn', 'fail': 'fail'}[r['status']], status_label)}</td>"
                 f"<td>{badge(check_state(r['ios']))}</td><td>{badge(check_state(r['android']))}</td>"
                 f"<td class='mono nowrap'>{p50.group(1) if p50 else ''}{' / ' + worst.group(1) if worst else ''}</td>"
                 f"<td class=mono>{html.escape(note)}</td></tr>")
    passed = sum(r["status"] != "fail" for r in results)
    page = f"""<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">
<title>Lottie check</title><style>{CSS}</style>
<h1>Lottie check</h1><p class=mono>{passed} of {len(results)} play on both · {time.strftime('%d %b %Y %H:%M')}</p>
