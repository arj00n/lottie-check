#!/usr/bin/env python3
"""Test .lottie / Lottie .json files against the players Swish ships, before uploading them.

  lottie-check FILE [FILE ...] [--frames 0,60,120] [--no-ios] [--no-android] [--emulator]
                               [--force] [--notify] [--json] [--no-open] [--out DIR]

For each file:
  1. lint     structural problems players disagree on (hollow layers, missing images, bad refs)
              plus budgets (vector path count, decoded image memory)
  2. iOS      lottie-ios 4.5.0, loaded the way lottie-react-native 7.3.5 loads a cached file://
              (headless on this Mac, Core Animation engine, see ios-harness/)
  3. Android  lottie-android 6.5.2 under Robolectric (real parser, real Skia, no emulator), with a
              per-frame draw-cost bench. --emulator uses the emulator app instead, loading over http
              via setAnimationFromUrl like Swish, and leaves the file looping on screen.
Results are cached by file content: an unchanged file is not re-tested unless --force.
Writes out/<name>-<hash>/report.html per file, out/index.html for multi-file runs, and opens it.
"""
import argparse, base64, fcntl, hashlib, html, http.server, json, os, re, shutil, socket, subprocess, sys
import tempfile, threading, time, zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent
# Homebrew lives in /opt/homebrew on Apple Silicon and /usr/local on Intel Macs
BREW = next((p for p in (Path("/opt/homebrew"), Path("/usr/local")) if (p / "bin/brew").exists()), Path("/opt/homebrew"))
SDK = Path(os.environ.get("ANDROID_SDK_ROOT") or BREW / "share/android-commandlinetools")
JAVA_HOME = os.environ.get("LOTTIE_JAVA_HOME") or str(BREW / "opt/openjdk@17")
ADB = str(SDK / "platform-tools/adb")
AVD = "lottie_check"
SYSTEM_IMAGE = "system-images;android-35;google_apis;arm64-v8a"
PKG = "in.justswish.lottiecheck"
APK = ROOT / "android/app/build/outputs/apk/debug/app-debug.apk"
# A prebuilt bundle (make-bundle.sh) ships bin/ and android/lib/; a source checkout builds them on demand.
BUNDLE = (ROOT / "bin/LottieCheckIOS").exists()
IOS_BIN = ROOT / "bin/LottieCheckIOS" if BUNDLE else ROOT / "ios-harness/.build/release/LottieCheckIOS"
REQUIRED_LAYER_KEYS = ("ty", "ip", "op", "st", "ks")
# Bump when checks change so cached results are recomputed.
TOOL_VERSION = "2"

# Budgets, from Swish's After Effects banners (GourmetHMnoSKU: 35 vector paths, ~8 MB of images).
MAX_VECTOR_PATHS = 250
MAX_IMAGE_MB = 24


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def env():
    e = dict(os.environ, JAVA_HOME=JAVA_HOME, ANDROID_SDK_ROOT=str(SDK), ANDROID_HOME=str(SDK))
    e["PATH"] = f"{JAVA_HOME}/bin:/usr/bin:/bin:/usr/sbin:/sbin:{e.get('PATH', '')}"
    return e


def newest_mtime(folder: Path, skip=("build", ".build", ".gradle", ".installed", "local.properties")):
    return max(p.stat().st_mtime for p in folder.rglob("*") if p.is_file() and not set(skip) & set(p.parts))


# ---------------------------------------------------------------- lint

def load_animation(path: Path):
    """Return (animation json, {packed image name: bytes})."""
    if path.suffix.lower() == ".json":
        return json.loads(path.read_text()), {}
    with zipfile.ZipFile(path) as z:
        names = z.namelist()
        anims = [n for n in names if re.match(r"(animations|a)/.+\.json$", n)]
        if not anims:
            raise ValueError("no animations/*.json inside the .lottie")
        images = {Path(n).name: z.read(n) for n in names if re.match(r"(images|i)/.+", n) and not n.endswith("/")}
        return json.loads(z.read(anims[0])), images


def image_size(data: bytes):
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return int.from_bytes(data[16:20], "big"), int.from_bytes(data[20:24], "big")
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        chunk = data[12:16]
        if chunk == b"VP8X":
            return 1 + int.from_bytes(data[24:27], "little"), 1 + int.from_bytes(data[27:30], "little")
        if chunk == b"VP8L":
            v = int.from_bytes(data[21:25], "little")
            return (v & 0x3FFF) + 1, ((v >> 14) & 0x3FFF) + 1
        if chunk == b"VP8 ":
            return int.from_bytes(data[26:28], "little") & 0x3FFF, int.from_bytes(data[28:30], "little") & 0x3FFF
    if data[:2] == b"\xff\xd8":
        i = 2
        while i < len(data) - 9:
            if data[i] == 0xFF and data[i + 1] in (0xC0, 0xC1, 0xC2):
                return int.from_bytes(data[i + 7:i + 9], "big"), int.from_bytes(data[i + 5:i + 7], "big")
            i += 2 + int.from_bytes(data[i + 2:i + 4], "big")
    return 0, 0


def count_paths(items):
    return sum((1 if it.get("ty") in ("sh", "rc", "el", "sr") else 0) + count_paths(it.get("it", [])) for it in items)


def lint(path: Path):
    """Return {"errors", "warnings", "info"}."""
    errors, warnings = [], []
    try:
        anim, packed = load_animation(path)
    except Exception as e:
        return {"errors": [f"cannot read file: {e}"], "warnings": [], "info": {}}

    assets = {a.get("id"): a for a in anim.get("assets", [])}
    comps = [("root", anim.get("layers", []))] + [(a["id"], a["layers"]) for a in anim.get("assets", []) if "layers" in a]
    paths_by_comp = {}
    for where, layers in comps:
        hollow = [i for i, l in enumerate(layers) if not all(k in l for k in REQUIRED_LAYER_KEYS)]
        if hollow:
            errors.append(f"{where}: {len(hollow)} of {len(layers)} layers are hollow (missing ty/ip/op/st/ks); "
                          "lottie-ios and lottie-android refuse the whole file, ThorVG silently drops them. "
                          "Repack from the exported JSON with fixes/pack_lottie.py")
        for l in layers:
            ref = l.get("refId")
            if ref is not None and ref not in assets:
                errors.append(f"{where}: layer {l.get('nm') or l.get('ind')} references missing asset {ref}")
        paths_by_comp[where] = sum(count_paths(l.get("shapes", [])) for l in layers)

    image_px = 0
    for a in assets.values():
        if "layers" in a or "p" not in a:
            continue
        p = str(a["p"])
        if p.startswith("data:"):
            w, h = image_size(base64.b64decode(p.split(",", 1)[1]))
        elif path.suffix.lower() == ".json":
            warnings.append(f"image {a['id']} is external ({a.get('u', '')}{p}); a bare .json can't carry it")
            continue
        elif Path(p).name not in packed:
            errors.append(f"image {a['id']} -> {p} is not packed in the .lottie")
            continue
        else:
            w, h = image_size(packed[Path(p).name])
        image_px += w * h

    vector_paths = sum(paths_by_comp.values())
    if vector_paths > MAX_VECTOR_PATHS:
        worst = max(paths_by_comp, key=paths_by_comp.get)
        warnings.append(f"heavy: {vector_paths} vector paths (budget {MAX_VECTOR_PATHS}, AE banners ~35), "
                        f"{paths_by_comp[worst]} of them in {worst}. Flatten static or opacity-only groups to images")
    image_mb = image_px * 4 / 1e6
    if image_mb > MAX_IMAGE_MB:
        warnings.append(f"heavy: images decode to {image_mb:.0f} MB (budget {MAX_IMAGE_MB} MB)")

    info = {
        "size": f"{anim.get('w')}x{anim.get('h')}",
        "frames": f"{anim.get('ip')}-{anim.get('op')} @ {anim.get('fr')}fps",
        "vector paths": vector_paths,
        "images": f"{sum(1 for a in assets.values() if 'p' in a)} ({image_mb:.0f} MB decoded)",
        "generator": (anim.get("meta") or {}).get("g", "") or (anim.get("nm") or ""),
    }
    span = (anim.get("ip", 0), anim.get("op", 0))
    return {"errors": errors, "warnings": warnings, "info": info, "span": span}


def default_frames(span):
    ip, op = span
    length = max(1, int(op) - int(ip))
    return sorted({int(ip) + length * k // 6 for k in (0, 2, 4)})


# ---------------------------------------------------------------- iOS (headless lottie-ios 4.5.0)

def ios_binary():
    harness = ROOT / "ios-harness"
    if BUNDLE:
        return IOS_BIN
    if not IOS_BIN.exists() or newest_mtime(harness) > IOS_BIN.stat().st_mtime:
        log("building iOS harness")
        subprocess.run(["swift", "build", "-c", "release", "-q"], cwd=harness, check=True, env=env())
    return IOS_BIN


def run_ios(path: Path, out: Path, frames):
    proc = subprocess.run([str(IOS_BIN), str(path), str(out)] + [str(f) for f in frames],
                          capture_output=True, text=True, timeout=300)
    lines = (proc.stdout + proc.stderr).splitlines()
    result = next((l for l in lines if l.startswith("RESULT")), "RESULT FAIL harness crashed")
    info = next((l[5:] for l in lines if l.startswith("INFO ")), "")
    notes = [l for l in lines if not l.startswith(("RESULT", "INFO "))][:20]
    ok = result == "RESULT OK"
    return {"ok": ok, "detail": info if ok else result[12:], "notes": notes}


# ---------------------------------------------------------------- Android under Robolectric (default)

def bundle_java():
    """Bundled JRE on Apple Silicon, otherwise an installed Java 17+."""
    bundled = ROOT / "jre/bin/java"
    if bundled.exists() and os.uname().machine == "arm64":
        return str(bundled)
    if (Path(JAVA_HOME) / "bin/java").exists():
        return str(Path(JAVA_HOME) / "bin/java")
    found = subprocess.run(["/usr/libexec/java_home", "-v", "17+"], capture_output=True, text=True).stdout.strip()
    if found:
        return f"{found}/bin/java"
    raise RuntimeError("Java 17+ not found: run install.sh")


def android_command(listing: Path, renders: Path):
    """The Robolectric check: plain java in a bundle, Gradle in a source checkout. Returns (argv, cwd)."""
    if not BUNDLE:
        return (["./gradlew", ":app:testDebugUnitTest", "-q", f"-PlottieList={listing}", f"-PlottieOut={renders}",
                 "-PlottieBench=true"], ROOT / "android")
    android = ROOT / "android"
    classpath = ":".join(str(android / entry) for entry in (android / "classpath.txt").read_text().split())
    # cwd=android/: Robolectric resolves the relative resource paths in config/…/test_config.properties from there
    # install.sh downloads Android's runtime jar here (Robolectric can't load it from a path with spaces)
    android_all = Path.home() / ".lottie-check/android-all"
    return ([bundle_java(), "-Xmx2g", "-Drobolectric.offline=true", f"-Drobolectric.dependency.dir={android_all}",
             f"-Dlottie.list={listing}", f"-Dlottie.out={renders}", "-Dlottie.bench=true",
             "-cp", classpath, "org.junit.runner.JUnitCore", "in.justswish.lottiecheck.RobolectricCheck"], android)


def run_android_robolectric(jobs):
    """jobs: list of (path, out dir, frames). Returns {path: result}. One JVM for the whole batch."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        staged = {}
        listing = []
        for path, out, frames in jobs:
            # unique staged name so two different files with the same name don't collide
            name = f"{out.name}{path.suffix}"
            shutil.copy(path, tmp / name)
            staged[str(tmp / name)] = (path, out)
            listing.append(f"{tmp / name}\t{','.join(map(str, frames))}")
        (tmp / "files.tsv").write_text("\n".join(listing))
        renders = tmp / "renders"
        renders.mkdir()
        argv, cwd = android_command(tmp / "files.tsv", renders)
        proc = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, env=env())
        results_file = renders / "android-results.txt"
        lines = results_file.read_text().splitlines() if results_file.exists() else []
        results = {}
        for line in lines:
            m = re.match(r"RESULT (OK|FAIL) (.+?) :: (.*)$", line)
            if not m or m.group(2) not in staged:
                continue
            path, out = staged[m.group(2)]
            parts = m.group(3).split(" :: ")
            for png in (renders / Path(m.group(2)).name).glob("android-f*.png"):
                shutil.move(str(png), out / png.name)
            results[path] = {"ok": m.group(1) == "OK", "detail": parts[0], "notes": parts[1:]}
        for path, out, _ in jobs:
            results.setdefault(path, {"ok": False, "detail": "Robolectric run crashed",
                                      "notes": (proc.stdout + proc.stderr).strip().splitlines()[-8:]})
        return results


# ---------------------------------------------------------------- Android on the emulator (--emulator)

def adb(*args, check=True, **kw):
    return subprocess.run([ADB, *args], check=check, capture_output=True, text=kw.pop("text", True), env=env(), **kw)


def ensure_emulator():
    if any(l.endswith("\tdevice") and l.startswith("emulator-") for l in adb("devices").stdout.splitlines()):
        return
    avds = subprocess.run([str(SDK / "emulator/emulator"), "-list-avds"], capture_output=True, text=True, env=env()).stdout.split()
    if AVD not in avds:
        log(f"creating AVD {AVD}")
        subprocess.run([str(SDK / "cmdline-tools/latest/bin/avdmanager"), "create", "avd", "-n", AVD,
                        "-k", SYSTEM_IMAGE, "-d", "pixel_7"], input="no\n", text=True, check=True,
                       capture_output=True, env=env())
    log("booting emulator (first boot takes a minute)")
    # -gpu host: on the default software renderer every file looks laggy
    subprocess.Popen([str(SDK / "emulator/emulator"), "-avd", AVD, "-no-snapshot-save", "-no-boot-anim", "-gpu", "host"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env(), start_new_session=True)
    adb("wait-for-device", timeout=180)
    deadline = time.time() + 240
    while adb("shell", "getprop", "sys.boot_completed", check=False).stdout.strip() != "1":
        if time.time() > deadline:
            raise RuntimeError("emulator did not finish booting")
        time.sleep(2)


def ensure_apk():
    if not APK.exists() or newest_mtime(ROOT / "android") > APK.stat().st_mtime:
        log("building Android app")
        subprocess.run(["./gradlew", "assembleDebug", "-q"], cwd=ROOT / "android", check=True, env=env())
    stamp = ROOT / "android/.installed"
    installed = PKG in adb("shell", "pm", "list", "packages", PKG, check=False).stdout
    if not installed or not stamp.exists() or APK.stat().st_mtime > float(stamp.read_text() or 0):
        adb("install", "-r", str(APK))
        stamp.write_text(str(APK.stat().st_mtime))


def serve(directory: Path):
    """Serve directory on a free port; the emulator reaches it through `adb reverse`."""
    handler = lambda *a, **k: http.server.SimpleHTTPRequestHandler(*a, directory=str(directory), **k)
    http.server.SimpleHTTPRequestHandler.log_message = lambda *a: None
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    adb("reverse", f"tcp:{port}", f"tcp:{port}")
    return server, port


def wait_log(pattern, timeout=60):
    deadline = time.time() + timeout
    rx = re.compile(pattern)
    while time.time() < deadline:
        for line in adb("logcat", "-d", "-s", "LOTTIE_CHECK:I", "-v", "raw").stdout.splitlines():
            if rx.search(line):
                return line
        time.sleep(0.3)
    return None


def run_android_emulator(path: Path, out: Path, frames, serve_dir: Path, port: int):
    name = f"{out.name}{path.suffix}"
    shutil.copy(path, serve_dir / name)
    url = f"http://127.0.0.1:{port}/{name}"
    activity = f"{PKG}/.MainActivity"
    adb("shell", "am", "force-stop", PKG)
    adb("logcat", "-c")
    adb("shell", "am", "start", "-W", "-n", activity, "--es", "url", url)
    line = wait_log(r"^(LOADED|FAILED)")
    notes = [l[8:] for l in adb("logcat", "-d", "-s", "LOTTIE_CHECK:I", "-v", "raw").stdout.splitlines() if l.startswith("WARNING")]
    if not line or line.startswith("FAILED"):
        return {"ok": False, "detail": (line or "FAILED no response from app")[7:], "notes": notes}
    m = re.search(r"size=(\d+)x(\d+)", line)
    size = (int(m.group(1)), int(m.group(2))) if m else None
    for f in frames:
        adb("logcat", "-c")
        adb("shell", "am", "start", "-n", activity, "--ei", "frame", str(f))
        wait_log(rf"^FRAME {f}$", timeout=15)
        shot = out / f"android-f{f}.png"
        shot.write_bytes(adb("exec-out", "screencap", "-p", text=False).stdout)
        if size:
            # FIT_CENTER on a full-screen view: the animation is the centred band of the screen width
            screen_w = int(re.search(r"(\d+)x\d+", adb("shell", "wm", "size").stdout).group(1))
            band_h = round(screen_w * size[1] / size[0])
            subprocess.run(["sips", "-c", str(band_h), str(screen_w), str(shot)], capture_output=True)
    adb("logcat", "-c")
    adb("shell", "am", "start", "-n", activity, "--ez", "bench", "true")
    bench = wait_log(r"^BENCH", timeout=300)
    adb("shell", "am", "start", "-n", activity, "--ez", "play", "true")
    notes.append(f"draw cost per frame: {bench[6:] if bench else 'bench timed out'}")
    return {"ok": True, "detail": line[7:], "notes": notes}


