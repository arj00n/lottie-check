def notify(results):
    failed = [r["name"] for r in results if r["status"] == "fail"]
    warned = [r["name"] for r in results if r["status"] == "warn"]
    if failed:
        title, text = f"✗ {len(failed)} of {len(results)} lotties fail", ", ".join(failed)
    elif warned:
        title, text = f"! {len(results)} play, {len(warned)} with warnings", ", ".join(warned)
    else:
        title, text = f"✓ {len(results)} lottie{'s' if len(results) > 1 else ''} play on iOS and Android", ", ".join(r["name"] for r in results)
    script = f"display notification {json.dumps(text[:200])} with title {json.dumps(title)}"
    subprocess.run(["osascript", "-e", script], capture_output=True)


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("files", nargs="+", type=Path)
    ap.add_argument("--frames", help="comma-separated frames to capture (default: start, 1/3 and 2/3 of each file)")
    ap.add_argument("--no-ios", action="store_true")
    ap.add_argument("--no-android", action="store_true")
    ap.add_argument("--emulator", action="store_true", help="check Android on the emulator instead of Robolectric")
    ap.add_argument("--force", action="store_true", help="re-test files even if cached")
    ap.add_argument("--notify", action="store_true", help="post a macOS notification with the outcome")
    ap.add_argument("--json", action="store_true", help="print results as JSON on stdout")
    ap.add_argument("--no-open", action="store_true")
    ap.add_argument("--out", type=Path, default=ROOT / "out")
    a = ap.parse_args()
    if a.emulator and BUNDLE:
        sys.exit("--emulator needs the source checkout (git clone + ./install.sh); the bundle checks Android with Robolectric")
    a.out.mkdir(parents=True, exist_ok=True)
    signature = f"v{TOOL_VERSION} frames={a.frames} ios={not a.no_ios} android={'' if a.no_android else 'emu' if a.emulator else 'robo'}"

    # one run at a time: Finder, the inbox watcher and the terminal share the Gradle build and emulator
    lock = open(a.out / ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)

    results, todo = [], []
    for path in a.files:
        path = path.expanduser().resolve()
        if not path.is_file() or path.suffix.lower() not in (".lottie", ".json"):
            log(f"skipping {path.name}: not a .lottie or .json file")
            continue
        digest = hashlib.sha1(path.read_bytes()).hexdigest()[:10]
        out = a.out / f"{path.stem}-{digest}"
        cached = out / "result.json"
        if not a.force and cached.exists():
            prev = json.loads(cached.read_text())
            if prev.get("signature") == signature:
                prev["path"] = str(path)
                results.append(prev)
                log(f"{path.name}: cached ({prev['status']})")
                continue
        out.mkdir(parents=True, exist_ok=True)
        for old in out.glob("*-f*.png"):
            old.unlink()
        lint_res = lint(path)
        frames = [int(f) for f in a.frames.split(",")] if a.frames else default_frames(lint_res.get("span", (0, 1)))
        todo.append({"path": path, "out": out, "name": path.name, "frames": frames, "lint": lint_res,
                     "ios": None, "android": None, "signature": signature,
                     "android_via": "emulator" if a.emulator else "Robolectric"})

    if todo and not a.no_ios:
        ios_binary()
        for r in todo:
            r["ios"] = run_ios(r["path"], r["out"], r["frames"])
    if todo and not a.no_android:
        if a.emulator:
            ensure_emulator()
            ensure_apk()
            serve_dir = a.out / ".serve"
            serve_dir.mkdir(exist_ok=True)
            server, port = serve(serve_dir)
            for r in todo:
                r["android"] = run_android_emulator(r["path"], r["out"], r["frames"], serve_dir, port)
            server.shutdown()
            adb("reverse", "--remove-all", check=False)
        else:
            android = run_android_robolectric([(r["path"], r["out"], r["frames"]) for r in todo])
            for r in todo:
                r["android"] = android[r["path"]]

    for r in todo:
        broken = r["lint"]["errors"] or (r["ios"] and not r["ios"]["ok"]) or (r["android"] and not r["android"]["ok"])
        r["status"] = "fail" if broken else "warn" if r["lint"]["warnings"] else "pass"
        write_report(r, r["out"])
        r["report"] = str(r["out"] / "report.html")
        r["report_rel"] = f"{r['out'].name}/report.html"
        r["path"] = str(r["path"])
        r["out"] = str(r["out"])
        Path(r["out"], "result.json").write_text(json.dumps(r, indent=1))
        results.append(r)

    for r in results:
        log(f"\n{r['name']}  [{r['status']}]")
        for e in r["lint"]["errors"]:
            log(f"  lint     ✗ {e}")
        for w in r["lint"]["warnings"]:
            log(f"  lint     ! {w}")
        for label, key in (("iOS", "ios"), ("Android", "android")):
            res = r[key]
            if res:
                log(f"  {label:<8} {'✓' if res['ok'] else '✗'} {res['detail']}")
                for n in res["notes"]:
                    log(f"           {n}")
        log(f"  report   {r['report']}")

    if not results:
        sys.exit(2)
    page = write_index(results, a.out) if len(results) > 1 else Path(results[0]["report"])
    (a.out / "last-run.json").write_text(json.dumps(results, indent=1))
    if a.json:
        print(json.dumps(results, indent=1))
    if a.notify:
        notify(results)
    if not a.no_open:
        subprocess.run(["open", str(page)])
    sys.exit(1 if any(r["status"] == "fail" for r in results) else 0)


if __name__ == "__main__":
    main()
